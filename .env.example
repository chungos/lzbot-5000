# Environment Configuration for LZBot-5000
# Copy this file to .env and fill in your actual values

# JIRA Configuration
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@domain.com
JIRA_API_TOKEN=your-jira-api-token-here
JIRA_PROJECT_KEY=YOUR_PROJECT
JIRA_BOARD_ID=1

# Confluence Configuration
CONFLUENCE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_SPACE_KEY=YOUR_SPACE
CONFLUENCE_PARENT_PAGE_ID=your-parent-page-id

# AWS Configuration (Optional)
AWS_REGION=ap-southeast-2

# Test Configuration (Optional)
# Set to "mock" to run tests in mock mode without real API calls
TEST_MODE=real

# MCP Server Path (Optional - for test_jira_simple.py)
MCP_SERVER_PATH=/path/to/your/jira-confluence-server/src

# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual values
# 3. Source the file: source .env
# 4. Or load it in your application

# How to get JIRA API Token:
# 1. Go to https://id.atlassian.com/manage-profile/security/api-tokens
# 2. Click "Create API token"
# 3. Copy the generated token

# How to find CONFLUENCE_PARENT_PAGE_ID:
# 1. Navigate to your Confluence space
# 2. Go to the parent page where you want to create sub-pages
# 3. The page ID is in the URL: /pages/{PAGE_ID}/page-title